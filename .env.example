NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

MONGODB_URI=mongodb://localhost:27017/whatsapp_ai_agent
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_OUTPUT_TOKENS=600
OPENAI_MAX_RETRIES=2
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_MAX_REQUESTS=20
MEMORY_SESSION_TIMEOUT_MINUTES=30
MEMORY_CONTEXT_MESSAGE_LIMIT=12
MEMORY_SUMMARY_TRIGGER_MESSAGES=30
MEMORY_RETENTION_DAYS=365
MEMORY_CLEANUP_INTERVAL_MINUTES=60
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_API_VERSION=v23.0

CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION_NAME=whatsapp_ai_agent_knowledge
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARACTERS=4000
UPLOAD_MAX_FILE_SIZE_MB=20
LOCAL_STORAGE_PATH=backend/uploads
LOG_LEVEL=info
